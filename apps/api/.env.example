# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://digimart:digimart@localhost:5432/digimart360?schema=public

# Auth. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API (mobile apps don't need CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Sign-in: Google. Comma-separated OAuth client IDs (web, Android, iOS) from
# Google Cloud Console > APIs & Services > Credentials. Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=

# Sign-in: email OTP. console = codes printed to the API log (development only).
# smtp = real email, e.g. smtps://USER:PASS@email-smtp.ap-south-1.amazonaws.com:465
MAIL_TRANSPORT=console
SMTP_URL=
MAIL_FROM=DIGI MART 360 <no-reply@digimart360.com>
OTP_TTL_MINUTES=10

# Initial admin account created by `npm run db:seed` (signs in with an email code)
SEED_ADMIN_EMAIL=admin@digimart360.local
