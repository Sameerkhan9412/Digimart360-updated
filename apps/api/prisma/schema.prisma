// DIGI MART 360 data model.
// Accounts and sign-in, then the catalog: categories, companies (suppliers)
// and products. RFQs and storefront settings come next.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// How a one-time code reaches the person. WHATSAPP and SMS are planned.
enum OtpChannel {
  EMAIL
  WHATSAPP
  SMS
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Null for accounts created by phone (WhatsApp code) until the person adds one.
  email           String?    @unique
  emailVerifiedAt DateTime?
  phone           String?    @unique
  /// Set when the person proved the number with a WhatsApp code. Only a verified number can sign in.
  phoneVerifiedAt DateTime?
  name            String
  avatarUrl       String?
  /// Google account "sub". Set when the person signs in with Google.
  googleId        String?    @unique
  role            Role       @default(BUYER)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions       RefreshToken[]
  company        Company?
  rfqs           Rfq[]
  savedSuppliers SavedSupplier[]

  @@map("users")
}

/// One row per signed-in device (browser, Android app, iOS app).
/// Only a SHA-256 hash of the token is stored.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  deviceName String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// A one-time sign-in code sent to an email address (later WhatsApp / SMS).
/// The code itself is never stored, only an HMAC of it.
model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  channel     OtpChannel
  /// Normalised email address or E.164 phone number.
  destination String
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([destination, createdAt])
  @@map("otp_challenges")
}

// ───────────────────────────── Catalog ─────────────────────────────

enum CompanyStatus {
  /// Created by the supplier; not visible until an admin approves it.
  PENDING
  ACTIVE
  SUSPENDED
}

enum BusinessType {
  MANUFACTURER
  EXPORTER
  WHOLESALER
  TRADER
  RETAILER
  SERVICE_PROVIDER
}

enum ProductStatus {
  DRAFT
  /// Waiting for moderation.
  PENDING_REVIEW
  ACTIVE
  REJECTED
  /// Hidden by the supplier. Kept so old links and RFQs still resolve.
  ARCHIVED
}

/// Three levels: group (Industrial Machinery) > category (Valves & Fittings) > leaf (Ball Valves).
/// Products attach to any level, normally a leaf.
model Category {
  id             String   @id @default(uuid()) @db.Uuid
  parentId       String?  @db.Uuid
  name           String
  /// Unique across the tree, used in URLs: /c/ball-valves
  slug           String   @unique
  description    String?
  icon           String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]
  rfqs     Rfq[]

  @@index([parentId, sortOrder])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "categories_name_trgm_idx")
  @@map("categories")
}

/// A supplier business. One per supplier account for now (team members later).
model Company {
  id              String         @id @default(uuid()) @db.Uuid
  ownerId         String         @unique @db.Uuid
  name            String
  /// Storefront path: digimart360.com/store/<slug>
  slug            String         @unique
  legalName       String?
  gstin           String?        @unique
  gstVerifiedAt   DateTime?
  businessTypes   BusinessType[]
  yearEstablished Int?
  description     String?
  logoUrl         String?
  phone           String?
  email           String?
  website         String?
  addressLine     String?
  city            String
  state           String
  pincode         String?
  /// "DM Trusted": inspected by DIGI MART staff.
  trustSeal       Boolean        @default(false)
  exportsTo       String[]
  status          CompanyStatus  @default(PENDING)
  /// Typical first-reply time, shown on listings. Computed from inquiries later.
  responseHours   Int?
  ratingAvg       Decimal?       @db.Decimal(2, 1)
  ratingCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products     Product[]
  invites      RfqInvite[]
  quotes       Quote[]
  storefront   Storefront?
  customDomain CustomDomain?
  dailyViews   CompanyDailyView[]
  savedBy      SavedSupplier[]

  @@index([status, city])
  @@index([businessTypes], type: Gin, map: "companies_business_types_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "companies_name_trgm_idx")
  @@map("companies")
}

model Product {
  id              String                   @id @default(uuid()) @db.Uuid
  companyId       String                   @db.Uuid
  categoryId      String                   @db.Uuid
  name            String
  /// Globally unique, used in URLs: /p/ss304-flanged-ball-valve-k3x9
  slug            String                   @unique
  summary         String?
  description     String?
  /// Price range in rupees. Both null = "Ask for price".
  priceMin        Decimal?                 @db.Decimal(12, 2)
  priceMax        Decimal?                 @db.Decimal(12, 2)
  /// What one price buys: Piece, Kg, Tonne, Box, Metre…
  priceUnit       String                   @default("Piece")
  moq             Int?
  /// [{ "label": "Material", "value": "SS304 / CF8" }, …]
  specs           Json                     @default("[]")
  images          String[]
  status          ProductStatus            @default(PENDING_REVIEW)
  rejectionReason String?
  publishedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  /// Full-text search document, maintained by PostgreSQL (generated column).
  searchVector    Unsupported("tsvector")?

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  dailyViews ProductDailyView[]

  @@index([status, categoryId])
  @@index([companyId, status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  // Also in SQL only (Prisma can't express them; scripts/new-migration.mjs keeps them):
  //   products_searchVector_idx (GIN on the generated searchVector column)
  //   products_active_price_idx (partial index, status = 'ACTIVE')
  //   products_price_range_chk, products_moq_chk (CHECK constraints)
  @@map("products")
}

enum RfqStatus {
  OPEN
  AWARDED
  /// The buyer ended it without choosing a quote.
  CLOSED
  /// Passed its closing date with no award.
  EXPIRED
}

enum QuoteStatus {
  SUBMITTED
  WITHDRAWN
  AWARDED
  NOT_SELECTED
}

/// A buyer's requirement ("request for quotation"). Matched suppliers are invited and send quotes.
model Rfq {
  id             String    @id @default(uuid()) @db.Uuid
  /// Shown to people: RFQ-202611-0042
  number         String    @unique
  buyerId        String    @db.Uuid
  categoryId     String    @db.Uuid
  /// Set when the buyer started from a product page.
  productId      String?   @db.Uuid
  /// Set when the buyer asked one specific supplier. That supplier is always invited.
  companyId      String?   @db.Uuid
  title          String
  description    String?
  quantity       Int
  unit           String    @default("Piece")
  city           String
  state          String
  /// Total budget in rupees, optional.
  budget         Decimal?  @db.Decimal(14, 2)
  status         RfqStatus @default(OPEN)
  closesAt       DateTime
  awardedQuoteId String?   @unique @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  buyer    User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  category Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  invites  RfqInvite[]
  quotes   Quote[]

  @@index([buyerId, createdAt])
  @@index([status, categoryId, closesAt])
  @@map("rfqs")
}

/// Which suppliers were told about an RFQ (the matching result), and whether they looked.
model RfqInvite {
  id         String    @id @default(uuid()) @db.Uuid
  rfqId      String    @db.Uuid
  companyId  String    @db.Uuid
  notifiedAt DateTime  @default(now())
  viewedAt   DateTime?

  rfq     Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([rfqId, companyId])
  @@index([companyId, notifiedAt])
  @@map("rfq_invites")
}

/// A supplier's offer on an RFQ. One per supplier; revising it bumps `revision`.
model Quote {
  id           String      @id @default(uuid()) @db.Uuid
  rfqId        String      @db.Uuid
  companyId    String      @db.Uuid
  unitPrice    Decimal     @db.Decimal(12, 2)
  deliveryDays Int
  material     String?
  warranty     String?
  paymentTerms String?
  certificates String?
  note         String?
  validUntil   DateTime?
  revision     Int         @default(1)
  status       QuoteStatus @default(SUBMITTED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  rfq     Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([rfqId, companyId])
  @@index([companyId, status])
  @@map("quotes")
}

// ───────────────────────────── Storefronts ─────────────────────────────

enum StorefrontTheme {
  BAZAAR
  FORGE
  HERITAGE
  MERIDIAN
}

enum DomainStatus {
  /// Waiting for the supplier to add the DNS record that proves ownership.
  PENDING_DNS
  /// Ownership proven; waiting for staff approval.
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

/// How a supplier's own website looks. One per company; created on first save.
model Storefront {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @unique @db.Uuid
  theme            StorefrontTheme @default(MERIDIAN)
  /// Brand colour as #rrggbb; null = the theme's own.
  accent           String?
  tagline          String?
  bannerUrl        String?
  showAbout        Boolean         @default(true)
  showProducts     Boolean         @default(true)
  showCertificates Boolean         @default(true)
  showContact      Boolean         @default(true)
  certificates     String[]
  updatedAt        DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("storefronts")
}

/// A supplier's own domain (www.theirbrand.com) pointing at their storefront.
model CustomDomain {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @unique @db.Uuid
  /// Lower-case host name, unique across suppliers.
  host            String       @unique
  /// The supplier proves ownership by publishing this as a TXT record at _digimart-verify.<host>.
  verifyToken     String
  status          DomainStatus @default(PENDING_DNS)
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("custom_domains")
}

// ───────────────────────────── Analytics ─────────────────────────────
// Daily counters, not one row per visit: a supplier's numbers stay cheap to read and the table
// grows by at most (products x days). Days are Indian calendar days (Asia/Kolkata).

enum CompanyViewKind {
  /// The supplier's page on the marketplace (/store/<slug>).
  PROFILE
  /// The supplier's own website (subdomain or custom domain).
  SITE
}

model ProductDailyView {
  productId String   @db.Uuid
  day       DateTime @db.Date
  count     Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, day])
  @@index([day])
  @@map("product_daily_views")
}

model CompanyDailyView {
  companyId String          @db.Uuid
  kind      CompanyViewKind
  day       DateTime        @db.Date
  count     Int             @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, kind, day])
  @@index([day])
  @@map("company_daily_views")
}

/// A buyer's shortlist: suppliers they want to find again.
model SavedSupplier {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([userId, createdAt])
  @@map("saved_suppliers")
}
