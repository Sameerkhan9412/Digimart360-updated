# Copy to .env.local. Never commit .env.local.

# Public URL of this website (canonical links, sitemap, Open Graph).
SITE_URL=http://localhost:3001

# API, as reached from the Next.js server (inside Docker: http://api:3000/api/v1).
API_URL=http://localhost:3000/api/v1
# API, as reached from visitors' browsers (search suggestions).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Same value as INTERNAL_API_KEY in apps/api/.env: server-side requests skip per-IP rate limits.
INTERNAL_API_KEY=

# Only the production site may be indexed by search engines.
ALLOW_INDEXING=false

# Supplier websites live at <slug>.ROOT_DOMAIN (localhost in development: http://<slug>.localhost:3001).
ROOT_DOMAIN=localhost
