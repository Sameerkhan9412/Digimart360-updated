{
	email {$ACME_EMAIL}
	# Certificates for supplier websites are requested on the first visit, but only for hosts
	# the API says belong to an approved supplier (sub-domain or approved custom domain).
	on_demand_tls {
		ask http://api:3000/api/v1/internal/certificate-allowed
	}
}

{$DOMAIN} {
	encode zstd gzip

	# The API and uploaded photos share the website's address, so browsers need no CORS.
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /media/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3001
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Plain http:// visits to supplier hosts (sub-domains and their own domains) go to https.
http:// {
	redir https://{host}{uri} permanent
}

# Supplier websites: <slug>.{$DOMAIN} and suppliers' own domains. Only the website, never the API.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:3001
}
