# Copy to .env next to docker-compose.yml. Never commit .env.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Public address of the site (no https://) and the email Let's Encrypt may contact.
DOMAIN=digimart360.com
ACME_EMAIL=ops@digimart360.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
INTERNAL_API_KEY=

# Email for sign-in codes and requirement alerts, e.g. smtps://USER:PASS@email-smtp.ap-south-1.amazonaws.com:465
# (MAIL_TRANSPORT=console only prints codes in the API log: testing, not production.)
MAIL_TRANSPORT=smtp
SMTP_URL=
MAIL_FROM=DIGI MART 360 <no-reply@digimart360.com>

GOOGLE_CLIENT_IDS=
SEED_ADMIN_EMAIL=

# Set to true only on the real production site.
ALLOW_INDEXING=false

# Optional: where deploy/check.sh sends alerts (email needs `mail` on the server; webhook = Slack/Discord URL).
ALERT_EMAIL=
ALERT_WEBHOOK=
